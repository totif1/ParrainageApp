# Configuration d'environnement pour l'application Parrainage BUT
# Copiez ce fichier vers .env et adaptez les valeurs selon votre environnement

# ===================
# BASE DE DONNÉES
# ===================
DB_HOST=database
DB_NAME=parrainage_db
DB_USER=parrainage_user
DB_PASSWORD=parrainage_pass_changeme
MYSQL_ROOT_PASSWORD=root_password_changeme

# ===================
# AUTHENTIFICATION JWT
# ===================
JWT_SECRET=changez_cette_cle_secrete_en_production_2024
JWT_EXPIRATION=86400

# ===================
# CONFIGURATION SERVEUR
# ===================
# Ports d'exposition (modifiez si ces ports sont déjà utilisés)
FRONTEND_PORT=4200
BACKEND_PORT=8080
DATABASE_PORT=3306

# Environnement (development|production)
APP_ENV=production
APP_DEBUG=false

# ===================
# CONFIGURATION EMAIL (pour les futures fonctionnalités)
# ===================
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Parrainage BUT Informatique"

# ===================
# DOMAINES AUTORISÉS (CORS)
# ===================
ALLOWED_ORIGINS=http://localhost:4200,https://yourdomain.com

# ===================
# CONFIGURATION ADMIN PAR DÉFAUT
# ===================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123_changeme

# ===================
# LOGS ET MONITORING
# ===================
LOG_LEVEL=warning
ENABLE_API_LOGGING=false

# ===================
# SÉCURITÉ
# ===================
# Clé de chiffrement pour les données sensibles
ENCRYPTION_KEY=changez_cette_cle_de_chiffrement
# Activation du HTTPS en production
FORCE_HTTPS=false