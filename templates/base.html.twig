<!DOCTYPE html>
<html lang="fr" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Parrainage BUT Informatique{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='%23A6CE39'/%3E%3Cellipse cx='19' cy='22' rx='17' ry='9' fill='%2300A3DD'/%3E%3C/svg%3E">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body class="flex min-h-full flex-col bg-cream text-navy antialiased">
        {% block header %}
            <header class="mx-auto w-full max-w-6xl px-4 pt-6">
                <nav class="flex items-center justify-between rounded-full border border-line bg-white py-3 pl-5 pr-3">
                    <a href="{{ path('home') }}" class="flex items-center gap-3">
                        <span class="relative block h-8 w-8 overflow-hidden rounded-full bg-lime">
                            <span class="absolute -left-1.5 top-3.5 h-6 w-11 rounded-full bg-cyan"></span>
                        </span>
                        <span class="font-display text-lg font-extrabold tracking-tight">Parrainage BUT</span>
                    </a>
                    <div class="flex items-center gap-4 text-[15px] sm:gap-5">
                        {% if app.user %}
                            <a href="{{ path('admin_dashboard') }}" class="text-muted hover:text-navy">Admin</a>
                            <a href="{{ path('admin_logout') }}" class="btn-accent">Déconnexion</a>
                        {% else %}
                            <a href="{{ path('admin_login') }}" class="text-muted hover:text-navy">Admin</a>
                            <a href="{{ path('inscription') }}" class="hidden rounded-full bg-navy px-5 py-2.5 font-medium text-cream sm:inline-block">Je m'inscris</a>
                        {% endif %}
                    </div>
                </nav>
            </header>
        {% endblock %}

        <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-10">
            {% block flashes %}
                {% for label, messages in app.flashes(['success', 'error']) %}
                    {% for message in messages %}
                        <div class="mb-6 {{ label == 'success' ? 'flash-ok' : 'flash-err' }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}
            {% endblock %}
            {% block body %}{% endblock %}
        </main>

        {% block footer %}
            <footer class="mx-auto w-full max-w-6xl px-4 pb-8">
                <div class="flex flex-col items-center justify-between gap-2 rounded-full border border-line bg-white px-6 py-4 font-mono text-[11px] tracking-wider text-muted sm:flex-row">
                    <span>BDE AGIIS · IUT MONTPELLIER–SÈTE</span>
                    <span>Made with ♥ by IUT Team</span>
                    <span>{{ "now"|date("Y") }}</span>
                </div>
            </footer>
        {% endblock %}
    </body>
</html>
