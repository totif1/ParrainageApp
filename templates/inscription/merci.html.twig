{% extends 'base.html.twig' %}

{% block title %}Merci — Parrainage BUT{% endblock %}

{% block body %}
    <div class="flex justify-center py-6">
        <div class="relative w-full max-w-lg overflow-hidden rounded-[40px] bg-lime p-10 sm:p-14">
            <span class="absolute left-10 top-12 h-4 w-4 rounded-full bg-navy"></span>
            <span class="absolute right-16 top-24 h-6 w-6 rounded-full bg-cyan"></span>
            <span class="absolute bottom-16 left-16 h-5 w-5 rounded-full bg-cream"></span>
            <span class="absolute bottom-24 right-10 h-3.5 w-3.5 rounded-full bg-navy"></span>

            <div class="relative mx-auto max-w-sm rounded-[999px_999px_48px_48px] bg-cream px-8 pb-9 pt-10 text-center">
                <span class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-navy text-4xl text-lime">✓</span>
                <h1 class="mt-5 font-display text-3xl font-extrabold leading-tight tracking-tight">Inscription<br>enregistrée</h1>
                <p class="mt-3 leading-relaxed text-muted2">
                    Merci ! Les binômes sont faits chaque semaine — tu reçois un mail dès que c'est bon.
                </p>
                <a href="{{ path('home') }}" class="btn-dark mt-6">Retour à l'accueil</a>
            </div>
        </div>
    </div>
{% endblock %}
