{% extends 'base.html.twig' %}

{% block title %}Inscription — Parrainage BUT{% endblock %}

{% block body %}
    <div class="mx-auto max-w-xl">
        <h1 class="text-2xl font-bold text-slate-900">Formulaire d'inscription</h1>
        <p class="mt-2 text-sm text-slate-600">Tous les champs sont obligatoires sauf mention contraire.</p>

        <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6">
            {{ form_start(form) }}
                <div class="grid gap-5 sm:grid-cols-2">
                    <div>{{ form_row(form.prenom) }}</div>
                    <div>{{ form_row(form.nom) }}</div>
                </div>
                {{ form_row(form.email) }}
                {{ form_row(form.classe) }}
                {{ form_row(form.preference) }}
                {{ form_row(form.motivation) }}
                <div class="grid gap-5 sm:grid-cols-2">
                    <div>{{ form_row(form.discord) }}</div>
                    <div>{{ form_row(form.insta) }}</div>
                </div>

                <button type="submit"
                        class="mt-6 w-full rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
                    Envoyer mon inscription
                </button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
