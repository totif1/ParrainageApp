{% extends 'base.html.twig' %}

{% block title %}Inscription — Parrainage BUT{% endblock %}

{% block body %}
    <div class="flex justify-center py-4">
        <div class="relative w-full max-w-2xl rounded-[48px] border border-line bg-white p-8 shadow-[0_24px_60px_rgba(18,35,46,0.08)] sm:p-12">
            <span class="sticker absolute -right-3 -top-4 rotate-[8deg]">2 MIN · 8 CHAMPS</span>

            <h1 class="font-display text-4xl font-extrabold tracking-tight">Raconte-nous</h1>
            <p class="mt-3 max-w-[52ch] leading-relaxed text-muted2">
                Rien n'est public : seul le bureau de l'asso lit ces réponses pour construire les binômes.
            </p>

            {{ form_start(form) }}
                <div class="mt-8 grid gap-4 sm:grid-cols-2">
                    {{ form_row(form.prenom) }}
                    {{ form_row(form.nom) }}
                </div>
                {{ form_row(form.email) }}
                {{ form_row(form.classe) }}
                {{ form_row(form.preference) }}
                {{ form_row(form.motivation) }}
                <div class="grid gap-4 sm:grid-cols-2">
                    {{ form_row(form.discord) }}
                    {{ form_row(form.insta) }}
                </div>

                <button type="submit" class="btn-primary mt-6 w-full">Envoyer mon inscription →</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
