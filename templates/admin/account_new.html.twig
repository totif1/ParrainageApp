{% extends 'base.html.twig' %}

{% block title %}Nouveau compte admin — Parrainage BUT{% endblock %}

{% block header %}
    {% embed 'admin/_header.html.twig' with {title: 'Nouveau compte admin', back_to: path('admin_dashboard')} %}{% endembed %}
{% endblock %}

{% block body %}
    <div class="grid gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-start">
        <div class="relative rounded-[48px] border border-line bg-white p-8 sm:p-12">
            <span class="sticker absolute -right-3 -top-4 rotate-[8deg]">ACCÈS BUREAU</span>

            <h2 class="font-display text-3xl font-extrabold tracking-tight">Créer un accès</h2>
            <p class="mt-3 max-w-[52ch] leading-relaxed text-muted2">
                La personne pourra se connecter sur <span class="font-mono text-[13px]">/admin/login</span>
                avec ces identifiants. Transmets-lui le mot de passe par un canal sûr
                (pas par email en clair).
            </p>

            {{ form_start(form) }}
                {{ form_row(form.username) }}
                <div class="grid gap-4 sm:grid-cols-2">
                    {{ form_row(form.plainPassword.first) }}
                    {{ form_row(form.plainPassword.second) }}
                </div>

                <button type="submit" class="btn-primary mt-6 w-full">Créer le compte →</button>
            {{ form_end(form) }}
        </div>

        <div class="rounded-[40px] border border-line bg-white p-8">
            <div class="lbl">Comptes existants</div>
            <ul class="mt-4 flex flex-col gap-3">
                {% for a in admins %}
                    <li class="flex items-center justify-between gap-3 rounded-full border border-line bg-cream px-5 py-3 text-sm">
                        <span class="font-medium">{{ a.username }}</span>
                        <span class="font-mono text-xs text-muted">{{ a.createdAt|date('d/m/Y') }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}
