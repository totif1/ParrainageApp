{% extends 'base.html.twig' %}
{% from 'admin/_badges.html.twig' import classe as classe_badge, preference as pref_badge %}

{% block title %}Tableau de bord — Parrainage BUT{% endblock %}

{% block header %}
    {% embed 'admin/_header.html.twig' with {title: 'Tableau de bord'} %}
        {% block actions %}
            {% if is_granted('ROLE_SUPER_ADMIN') %}
                <a href="{{ path('admin_account_new') }}"
                   class="rounded-full border-[1.5px] border-[#40566a] px-5 py-2.5 text-cream transition hover:bg-navysoft">Nouveau compte</a>
            {% endif %}
            <a href="{{ path('admin_my_account') }}"
               class="rounded-full border-[1.5px] border-[#40566a] px-5 py-2.5 text-cream transition hover:bg-navysoft">Mon compte</a>
            <a href="{{ path('admin_export') }}"
               class="rounded-full border-[1.5px] border-[#40566a] px-5 py-2.5 text-cream transition hover:bg-navysoft">Export CSV</a>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    {# --- Statistiques --- #}
    <div class="flex flex-wrap items-center gap-5">
        <div class="flex h-44 w-44 -rotate-[3deg] flex-col items-center justify-center rounded-full border-[1.5px] border-line bg-white text-center">
            <span class="font-display text-5xl font-extrabold leading-none">{{ stats.total }}</span>
            <span class="text-sm text-muted">total</span>
        </div>
        <div class="flex h-44 w-44 rotate-[2deg] flex-col items-center justify-center rounded-full bg-lime text-center text-navy">
            <span class="font-display text-5xl font-extrabold leading-none">{{ stats.recent }}</span>
            <span class="text-sm">24 dernières h</span>
        </div>
        <div class="min-w-72 flex-1 rounded-[40px] border-[1.5px] border-line bg-white px-8 py-6">
            <div class="lbl">Répartition par classe</div>
            <div class="mt-3.5 flex flex-col gap-2.5">
                {% for classe, count in stats.byClass %}
                    <div class="flex items-center gap-3">
                        <span class="h-3 rounded-full bg-cyan"
                              style="width: {{ (30 + count / max(stats.total, 1) * 170)|round }}px"></span>
                        <span class="text-sm">{{ classe }}</span>
                        <span class="font-display font-bold">{{ count }}</span>
                    </div>
                {% else %}
                    <div class="text-sm text-muted">Aucune donnée</div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# --- Filtres --- #}
    <form method="get" class="mt-7 flex flex-wrap items-center gap-3">
        <select name="classe" class="field field-select">
            <option value="">Classe — toutes</option>
            {% for c in classes %}
                <option value="{{ c.value }}" {{ filterClasse == c ? 'selected' }}>{{ c.label }}</option>
            {% endfor %}
        </select>
        <input name="email" value="{{ filterEmail }}" placeholder="Email contient…" class="field min-w-60">
        <button class="inline-flex items-center rounded-full bg-cyandark px-7 py-3 font-display text-[15px] font-bold text-white transition hover:bg-cyandarker focus:outline-none focus:ring-4 focus:ring-[#cfeaf8]">Filtrer</button>
        {% if filterClasse or filterEmail %}
            <a href="{{ path('admin_dashboard') }}" class="border-b-2 border-lime pb-0.5 font-medium">Réinitialiser</a>
        {% endif %}
        <span class="ml-auto font-mono text-xs text-muted">
            {{ inscriptions|length }} RÉSULTAT{{ inscriptions|length > 1 ? 'S' }}
        </span>
    </form>

    {# --- En-têtes de colonnes (desktop) --- #}
    <div class="mt-6 hidden grid-cols-[1.6fr_1.3fr_1fr_0.9fr_1fr_0.7fr_0.7fr] gap-4 px-8 font-mono text-[11px] uppercase tracking-wider text-muted lg:grid">
        <div>Nom</div><div>Email</div><div>Classe</div><div>Souhait</div><div>Contacts</div><div>Date</div>
        <div class="text-right">Action</div>
    </div>

    {# --- Lignes en pastilles — cliquables, détail complet en pop-up --- #}
    <div class="mt-2.5 flex flex-col gap-2.5">
        {% for i in inscriptions %}
            {%- set contacts = [i.discord, i.insta]|filter(v => v is not empty)|join(' · ') -%}
            <div class="grid cursor-pointer grid-cols-1 gap-2 rounded-[28px] border-[1.5px] border-line bg-white px-6 py-4 text-sm transition hover:border-cyandark
                        lg:grid-cols-[1.6fr_1.3fr_1fr_0.9fr_1fr_0.7fr_0.7fr] lg:items-center lg:gap-4 lg:rounded-full"
                 data-controller="modal" data-action="click->modal#open keydown.enter->modal#open"
                 role="button" tabindex="0">
                <div class="min-w-0">
                    <div class="font-bold">{{ i.prenom }} {{ i.nom }}</div>
                    {% if i.motivation %}
                        <div class="truncate text-[13px] text-muted">{{ i.motivation }}</div>
                    {% endif %}
                </div>
                <div class="min-w-0 truncate text-[13px] text-muted2">{{ i.email }}</div>
                <div>{{ classe_badge(i.classe) }}</div>
                <div>{{ pref_badge(i.preference) }}</div>
                <div class="min-w-0 truncate text-[13px] text-muted2">{{ contacts ?: '—' }}</div>
                <div class="text-[13px] text-muted">{{ i.dateInscription|date('d/m') }}</div>
                <div class="lg:text-right" data-action="click->modal#stop">
                    <form method="post" action="{{ path('admin_inscription_delete', {id: i.id}) }}"
                          onsubmit="return confirm('Supprimer l\'inscription de {{ i.prenom }} {{ i.nom }} ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_inscription_' ~ i.id) }}">
                        <button class="text-[13px] font-medium text-[#a51f16] hover:underline">Supprimer</button>
                    </form>
                </div>

                {# Détail complet — la ligne compacte ci-dessus ne montre qu'un aperçu tronqué. #}
                <dialog data-modal-target="dialog" data-action="click->modal#stop click->modal#closeOnBackdrop"
                        class="m-auto w-full max-w-lg rounded-[40px] border border-line bg-white p-0 text-navy">
                    <div class="p-8 sm:p-10">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <h3 class="font-display text-2xl font-extrabold tracking-tight">{{ i.prenom }} {{ i.nom }}</h3>
                                <div class="mt-2 flex flex-wrap gap-2">
                                    {{ classe_badge(i.classe) }}
                                    {{ pref_badge(i.preference) }}
                                </div>
                            </div>
                            <button type="button" data-action="modal#close" aria-label="Fermer"
                                    class="rounded-full p-2 text-muted transition hover:bg-cream hover:text-navy">✕</button>
                        </div>

                        <dl class="mt-6 flex flex-col gap-4 text-sm">
                            <div>
                                <dt class="lbl">Email</dt>
                                <dd class="mt-1"><a href="mailto:{{ i.email }}" class="text-cyandark hover:underline">{{ i.email }}</a></dd>
                            </div>
                            <div>
                                <dt class="lbl">Contacts</dt>
                                <dd class="mt-1 text-muted2">{{ contacts ?: '—' }}</dd>
                            </div>
                            <div>
                                <dt class="lbl">Inscrit·e le</dt>
                                <dd class="mt-1 text-muted2">{{ i.dateInscription|date('d/m/Y à H:i') }}</dd>
                            </div>
                            {% if i.motivation %}
                                <div>
                                    <dt class="lbl">Motivation</dt>
                                    <dd class="mt-1 whitespace-pre-line leading-relaxed text-muted2">{{ i.motivation }}</dd>
                                </div>
                            {% endif %}
                        </dl>

                        <div class="mt-8 flex items-center justify-between gap-3">
                            <form method="post" action="{{ path('admin_inscription_delete', {id: i.id}) }}"
                                  onsubmit="return confirm('Supprimer l\'inscription de {{ i.prenom }} {{ i.nom }} ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_inscription_' ~ i.id) }}">
                                <button class="text-sm font-medium text-[#a51f16] hover:underline">Supprimer l'inscription</button>
                            </form>
                            <button type="button" data-action="modal#close" class="btn-ghost">Fermer</button>
                        </div>
                    </div>
                </dialog>
            </div>
        {% else %}
            <div class="rounded-full border-2 border-dashed border-linestrong px-7 py-8 text-center">
                <div class="font-display text-xl font-bold">Aucune inscription pour ces filtres</div>
                <div class="mt-1 text-sm text-muted">Essaie de tout réinitialiser.</div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
