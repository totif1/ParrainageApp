{% extends 'base.html.twig' %}

{% block title %}Tableau de bord — Parrainage BUT{% endblock %}

{% block body %}
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-slate-900">Tableau de bord</h1>
        <a href="{{ path('admin_export') }}"
           class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
            Export CSV
        </a>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-white p-5">
            <div class="text-2xl font-bold text-slate-900">{{ stats.total }}</div>
            <div class="text-sm text-slate-500">inscriptions au total</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5">
            <div class="text-2xl font-bold text-slate-900">{{ stats.recent }}</div>
            <div class="text-sm text-slate-500">dans les dernières 24 h</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5">
            <div class="text-sm font-medium text-slate-500">Par classe</div>
            <ul class="mt-1 space-y-0.5 text-sm text-slate-700">
                {% for classe, count in stats.byClass %}
                    <li class="flex justify-between"><span>{{ classe }}</span><span class="font-semibold">{{ count }}</span></li>
                {% else %}
                    <li class="text-slate-400">Aucune donnée</li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <form method="get" class="mt-8 flex flex-wrap items-end gap-3">
        <div>
            <label class="block text-xs font-medium text-slate-600" for="classe">Classe</label>
            <select id="classe" name="classe"
                    class="mt-1 rounded-md border-slate-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
                <option value="">Toutes</option>
                {% for c in classes %}
                    <option value="{{ c.value }}" {{ filterClasse == c ? 'selected' }}>{{ c.label }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label class="block text-xs font-medium text-slate-600" for="email">Email contient</label>
            <input id="email" name="email" value="{{ filterEmail }}"
                   class="mt-1 rounded-md border-slate-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
        </div>
        <button type="submit" class="rounded-lg bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
            Filtrer
        </button>
        {% if filterClasse or filterEmail %}
            <a href="{{ path('admin_dashboard') }}" class="px-2 py-2 text-sm text-slate-500 hover:text-slate-700">Réinitialiser</a>
        {% endif %}
    </form>

    <div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                <tr>
                    <th class="px-4 py-3">Nom</th>
                    <th class="px-4 py-3">Email</th>
                    <th class="px-4 py-3">Classe</th>
                    <th class="px-4 py-3">Souhait</th>
                    <th class="px-4 py-3">Contacts</th>
                    <th class="px-4 py-3">Date</th>
                    <th class="px-4 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {% for i in inscriptions %}
                    <tr>
                        <td class="px-4 py-3">
                            <div class="font-medium text-slate-900">{{ i.prenom }} {{ i.nom }}</div>
                            {% if i.motivation %}
                                <div class="max-w-xs truncate text-xs text-slate-400" title="{{ i.motivation }}">{{ i.motivation }}</div>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-slate-600">{{ i.email }}</td>
                        <td class="px-4 py-3">{{ i.classe ? i.classe.value : '—' }}</td>
                        <td class="px-4 py-3">{{ i.preference ? i.preference.label : '—' }}</td>
                        <td class="px-4 py-3 text-xs text-slate-500">
                            {% if i.discord %}<div>Discord : {{ i.discord }}</div>{% endif %}
                            {% if i.insta %}<div>Insta : {{ i.insta }}</div>{% endif %}
                            {% if not i.discord and not i.insta %}—{% endif %}
                        </td>
                        <td class="px-4 py-3 whitespace-nowrap text-slate-500">{{ i.dateInscription|date('d/m/Y H:i') }}</td>
                        <td class="px-4 py-3 text-right">
                            <form method="post" action="{{ path('admin_inscription_delete', {id: i.id}) }}"
                                  onsubmit="return confirm('Supprimer l\'inscription de {{ i.prenom }} {{ i.nom }} ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_inscription_' ~ i.id) }}">
                                <button class="text-xs font-medium text-red-600 hover:text-red-500">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="px-4 py-8 text-center text-slate-400">Aucune inscription.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
