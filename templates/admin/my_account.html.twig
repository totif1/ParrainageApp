{% extends 'base.html.twig' %}

{% block title %}Mon compte — Parrainage BUT{% endblock %}

{% block header %}
    {% embed 'admin/_header.html.twig' with {title: 'Mon compte', back_to: path('admin_dashboard')} %}{% endembed %}
{% endblock %}

{% block body %}
    <div class="grid gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-start">
        <div class="relative rounded-[48px] border border-line bg-white p-8 sm:p-12">
            <span class="sticker absolute -right-3 -top-4 rotate-[8deg]">SÉCURITÉ</span>

            <h2 class="font-display text-3xl font-extrabold tracking-tight">Changer mon mot de passe</h2>
            <p class="mt-3 max-w-[52ch] leading-relaxed text-muted2">
                Un accès reçu avec un mot de passe temporaire ? C'est ici que tu le remplaces
                par le tien.
            </p>

            {{ form_start(form) }}
                {{ form_row(form.currentPassword) }}
                <div class="grid gap-4 sm:grid-cols-2">
                    {{ form_row(form.newPassword.first) }}
                    {{ form_row(form.newPassword.second) }}
                </div>

                <button type="submit" class="btn-primary mt-6 w-full">Mettre à jour le mot de passe →</button>
            {{ form_end(form) }}
        </div>

        <div class="rounded-[40px] border border-line bg-white p-8">
            <div class="lbl">Mon compte</div>
            <div class="mt-4 flex flex-col gap-3">
                <div class="flex items-center justify-between gap-3 rounded-full border border-line bg-cream px-5 py-3 text-sm">
                    <span class="font-medium">{{ admin.username }}</span>
                    {% if admin.superAdmin %}
                        <span class="badge bg-navy text-cream">Compte principal</span>
                    {% else %}
                        <span class="badge bg-[#eef3f6] text-[#3f484e]">Membre du bureau</span>
                    {% endif %}
                </div>
                <div class="flex items-center justify-between gap-3 px-5 text-sm text-muted">
                    <span>Créé le</span>
                    <span class="font-mono text-xs">{{ admin.createdAt|date('d/m/Y') }}</span>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
