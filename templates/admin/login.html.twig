{% extends 'base.html.twig' %}

{% block title %}Espace admin — Parrainage BUT{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
    <div class="flex min-h-[72vh] items-center justify-center">
        <div class="relative w-full max-w-md overflow-hidden rounded-[40px] bg-navy p-10 sm:p-14">
            <div class="pointer-events-none absolute -right-20 -top-16 h-64 w-64 rounded-full bg-navysoft"></div>

            <form method="post" class="relative rounded-[32px] bg-cream p-8">
                <h1 class="font-display text-2xl font-extrabold tracking-tight">Espace admin</h1>
                <p class="mt-1 text-sm text-muted">Réservé au bureau de l'asso.</p>

                {% if error %}
                    <div class="mt-4 flash-err">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <div class="mt-4">
                    <label class="lbl mb-1.5 block" for="username">Nom d'utilisateur</label>
                    <input id="username" name="_username" value="{{ last_username }}" required autofocus
                           class="field w-full">
                </div>

                <div class="mt-3.5">
                    <label class="lbl mb-1.5 block" for="password">Mot de passe</label>
                    <input type="password" id="password" name="_password" required class="field w-full">
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn-primary mt-6 w-full">Se connecter</button>

                <a href="{{ path('home') }}" class="mt-4 block text-center text-sm text-muted hover:text-navy">← Retour au site</a>
            </form>
        </div>
    </div>
{% endblock %}
