{
  "name": "parrainage-but/backend",
  "description": "API Backend pour le système de parrainage BUT Informatique",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.0",
    "ext-pdo": "*",
    "ext-json": "*",
    "firebase/php-jwt": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}